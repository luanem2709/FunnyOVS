# ===== Văn phòng 3D — cấu hình =====
# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit .env.

# --- Nhà cung cấp LLM (OpenAI-compatible) ---
# Bỏ trống => hệ thống chạy ở chế độ rule-based (vẫn dùng được, chỉ thiếu LLM).
# Ví dụ OpenAI:   OFFICE_LLM_BASE_URL=https://api.openai.com/v1
# Ví dụ OpenRouter: OFFICE_LLM_BASE_URL=https://openrouter.ai/api/v1
OFFICE_LLM_BASE_URL=
OFFICE_LLM_API_KEY=
OFFICE_LLM_MODEL=gpt-4o-mini

# --- Cổng server ---
PORT=8787

# --- Chrome cho trình duyệt sandbox ---
# Để trống => tự dò Chrome/Edge đã cài.
OFFICE_CHROME_PATH=

# --- Thư mục làm việc riêng cho agent (duy nhất agent được phép chạm) ---
# Mặc định: <dự án>/workspace
OFFICE_WORKSPACE=

# --- Thư mục dữ liệu (SQLite, nhật ký, cấu hình quyền) ---
# Mặc định: <dự án>/.data
OFFICE_DATA_DIR=
